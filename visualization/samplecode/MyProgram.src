&ACCESS RVP
&REL 9
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF MyProgram()
; ***PROGRAM_GENERATED_BY_______***
; ***MW__________________***
; ***FOR_MELTIO_DIRECTEDMETAL3D_***

Un_init()
TOOL_DATA[3]={FRAME: X 252.94,Y 0.13,Z 196.30,A 0,B -89.92,C 0.07}
BASE_DATA[4]={FRAME: X 1499.49,Y 0.55,Z 394.19,A 0.0,B 0.15,C 0.03}

; FOLD Initialise and set default speed
BAS (#INITMOV,0)
BAS (#VEL_PTP,100)
BAS (#ACC_PTP,20)
;BAS (#TOOL,0)
;BAS (#BASE,0)
;ENDFOLD

$ADVANCE = 5

;onStart
$APO.CPTP = 1
$APO.CDIS = 1

; ---- Setting reference (Base) ----
$BASE = BASE_DATA[4]
; --------------------------

; ---- Setting tool (TCP) ----
$TOOL = TOOL_DATA[3]
; --------------------------
VEL_APROX_PRINT=0.04
VEL_PRINT=0.01
DELAY_PROCESS_ON=5
VEL_DTIME=15
; Stage Two Robot Integration Simplified
$VEL.CP = 0.05
PTP $POS_ACT
LIN {E6POS: X 0.000,Y 0.000,Z 200.000,A 0,B 0,C 0,E1 0,E2 -45.0} C_DIS

;FOLD PRINT START
ENABLE_PROCESS = TRUE; Print Enable Status
WAIT SEC DELAY_PROCESS_ON;
;ENDFOLD Delay process

InitDeposition();
